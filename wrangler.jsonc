// Cloudflare Workers (static assets only, no Worker script). See docs/deployment.md.
{
  "name": "annual-leave-planner",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // There are no routes, but fall back to index.html rather than a bare 404.
    "not_found_handling": "single-page-application"
  },
  // Required by `wrangler preview` (per-branch preview deployments). Empty is fine:
  // assets and compatibility settings above are shared with previews.
  "previews": {}
}
