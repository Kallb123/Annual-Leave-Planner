{
  "name": "annual-leave-planner",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/update-bank-holidays.mjs --soft",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-bank-holidays": "node scripts/update-bank-holidays.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-og-image": "node scripts/generate-og-image.mjs",
    "bump": "npm version --no-git-tag-version"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
