# Cloudflare Pages. Copied to dist/ by Vite. See docs/deployment.md.

# Always revalidate the entry points so new deploys are noticed.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Hashed filenames never change, so cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
